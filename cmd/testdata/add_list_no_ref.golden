$ cat storyline/backlog.yaml
# yaml-language-server: $schema=https://raw.githubusercontent.com/fjbalsamo/storyline/main/schema/backlog.schema.json
version: 1
backlog:
  - id: US-001
    as: club player
    want: to book a court
    so_that: I can play
    status: done
    story: storyline/done/x/story.md
  - id: US-002
    as: admin
    want: to see bookings
    so_that: I can plan
    status: todo
  - id: US-003
    as: coach
    want: to cancel a class
    so_that: players are told
    status: in-progress
    story: storyline/active/y/story.md
  - id: US-004
    as: owner
    want: to close the club
    so_that: nobody turns up
    status: discarded
  - id: US-005
    as: referee
    want: to log a result
    so_that: scores are fair
    status: todo
  - id: US-006
    as: fan
    want: to follow a match
    so_that: I don't miss it
    status: todo
